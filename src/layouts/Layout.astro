---
import "../styles/global.css";
import isotipo from "../assets/Financial isotipo.svg";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Financial | Formalización Municipal vía WhatsApp",
  description = "Financial convierte a los vecinos informales de su comuna en contribuyentes activos, guiándolos por WhatsApp desde la primera consulta hasta el pago de la patente.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(isotipo.src, Astro.site);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Financial",
  description,
  url: canonicalURL.toString(),
  logo: ogImageURL.toString(),
  email: "grupofinancial06@gmail.com",
  sameAs: [
    "https://www.instagram.com/financial.cl/",
    "https://www.linkedin.com/company/financialcl/",
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3HX86BVYPB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", 'G-3HX86BVYPB');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={isotipo.src} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Financial" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="es_CL" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-black text-white antialiased">
    <a href="#top" class="skip-link">Saltar al contenido principal</a>
    <slot />
  </body>
</html>