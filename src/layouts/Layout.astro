---
import "../styles/global.css";
import isotipo from "../assets/Financial isotipo.svg";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Financial | Formalización Municipal vía WhatsApp",
  description = "Financial convierte a los vecinos informales de su comuna en contribuyentes activos, guiándolos por WhatsApp desde la primera consulta hasta el pago de la patente.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={isotipo.src} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-black text-white antialiased">
    <slot />
  </body>
</html>
