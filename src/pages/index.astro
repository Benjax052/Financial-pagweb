---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Diagnostico from "../components/Diagnostico.astro";
import ComoFunciona from "../components/ComoFunciona.astro";
import Beneficios from "../components/Beneficios.astro";
import Convenio from "../components/Convenio.astro";
import RoiSimulador from "../components/RoiSimulador.astro";
import CasosDeUso from "../components/CasosDeUso.astro";
import Seguridad from "../components/Seguridad.astro";
import Video from "../components/Video.astro";
import VisionMision from "../components/VisionMision.astro";
import Equipo from "../components/Equipo.astro";
import CtaFinal from "../components/CtaFinal.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header />
  <main id="top" tabindex="-1">
    <Hero />
    <Diagnostico />
    <ComoFunciona />
    <Beneficios />
    <Convenio />
    <RoiSimulador />
    <CasosDeUso />
    <Seguridad />
    <Video />
    <Equipo />
    <VisionMision />
    <CtaFinal />
  </main>
  <Footer />
</Layout>

<script>
  const revealEls = document.querySelectorAll(".reveal");
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          io.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  revealEls.forEach((el) => io.observe(el));
</script>
