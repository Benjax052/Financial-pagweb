<section id="impacto-roi" class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
  <div class="reveal mx-auto max-w-2xl text-center">
    <span class="text-xs font-bold uppercase tracking-widest text-emerald">Impacto & ROI</span>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
      Calcule el impacto estimado para su Municipio
    </h2>
  </div>

  <div class="reveal mx-auto mt-12 max-w-3xl rounded-3xl border border-white/10 bg-white/5 p-8 sm:p-10">
    <label for="comunaSelect" class="text-xs font-bold uppercase tracking-wide text-white/50"
      >Seleccione el tipo de comuna</label
    >
    <select
      id="comunaSelect"
      class="mt-3 w-full rounded-xl border border-white/15 bg-black px-4 py-3.5 text-sm font-semibold text-white focus:border-emerald focus:outline-none focus:ring-2 focus:ring-emerald/30"
    >
      <option value="emergente">Comuna Emergente · menos de 40.000 hab.</option>
      <option value="intermedia" selected>Comuna Intermedia · 40.000 – 120.000 hab.</option>
      <option value="consolidada">Comuna Consolidada · más de 120.000 hab.</option>
    </select>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-teal/25 bg-teal/5 p-6 text-center">
        <p id="outHoras" class="text-3xl font-extrabold text-teal">1.800</p>
        <p class="mt-1 text-xs font-semibold text-white/50">horas/año de atención presencial ahorradas</p>
      </div>
      <div class="rounded-2xl border border-emerald/25 bg-emerald/5 p-6 text-center">
        <p id="outPatentes" class="text-3xl font-extrabold text-emerald">350</p>
        <p class="mt-1 text-xs font-semibold text-white/50">nuevas patentes formalizadas estimadas/año</p>
      </div>
      <div class="rounded-2xl border border-white/15 bg-white/5 p-6 text-center">
        <p id="outIngreso" class="text-3xl font-extrabold text-white">$52M</p>
        <p class="mt-1 text-xs font-semibold text-white/50">ingreso adicional estimado por recaudación/año</p>
      </div>
    </div>

    <p class="mt-6 text-center text-[11px] text-white/35">
      *Estimación referencial basada en comunas piloto. Las cifras finales se ajustan tras el diagnóstico comunal.
    </p>
  </div>
</section>

<script>
  const roiData: Record<string, { horas: string; patentes: string; ingreso: string }> = {
    emergente: { horas: "900", patentes: "120", ingreso: "$18M" },
    intermedia: { horas: "1.800", patentes: "350", ingreso: "$52M" },
    consolidada: { horas: "3.200", patentes: "700", ingreso: "$110M" },
  };

  const comunaSelect = document.getElementById("comunaSelect") as HTMLSelectElement | null;
  const outHoras = document.getElementById("outHoras");
  const outPatentes = document.getElementById("outPatentes");
  const outIngreso = document.getElementById("outIngreso");

  function updateROI() {
    if (!comunaSelect) return;
    const data = roiData[comunaSelect.value];
    if (!data) return;
    if (outHoras) outHoras.textContent = data.horas;
    if (outPatentes) outPatentes.textContent = data.patentes;
    if (outIngreso) outIngreso.textContent = data.ingreso;
  }

  comunaSelect?.addEventListener("change", updateROI);
  updateROI();
</script>
