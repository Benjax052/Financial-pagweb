---
import SectionGlow from "./SectionGlow.astro";
---

<section id="impacto-roi" class="relative overflow-hidden py-24">
  <SectionGlow />
  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
  <div class="reveal mx-auto max-w-2xl text-center">
    <span class="text-sm font-bold uppercase tracking-widest text-petrol">Impacto & ROI</span>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-petrol sm:text-4xl">
      Calcule el impacto estimado para su Municipio
    </h2>
  </div>

  <div class="reveal mx-auto mt-12 max-w-3xl rounded-3xl border border-petrol/30 bg-petrol/16 p-8 sm:p-10">
    <label for="comunaSelect" class="text-sm font-bold uppercase tracking-wide text-petrol"
      >Seleccione el tipo de comuna</label
    >
    <select
      id="comunaSelect"
      class="mt-3 w-full rounded-xl border border-petrol/30 bg-petrol/[0.05] px-4 py-3.5 text-base font-semibold text-petrol focus:border-emerald focus:outline-none focus:ring-2 focus:ring-emerald/90"
    >
      <option value="emergente">Comuna Emergente · menos de 40.000 hab.</option>
      <option value="intermedia" selected>Comuna Intermedia · 40.000 – 120.000 hab.</option>
      <option value="consolidada">Comuna Consolidada · más de 120.000 hab.</option>
    </select>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-teal/55 bg-teal/32 p-6 text-center transition-all duration-300 hover:-translate-y-1 hover:border-teal/60">
        <p id="outHoras" class="text-3xl font-extrabold text-petrol">1.800</p>
        <p class="mt-1 text-sm font-semibold text-petrol/98">horas/año de atención presencial ahorradas</p>
      </div>
      <div class="rounded-2xl border border-emerald/55 bg-emerald/32 p-6 text-center transition-all duration-300 hover:-translate-y-1 hover:border-emerald/90">
        <p id="outPatentes" class="text-3xl font-extrabold text-petrol">350</p>
        <p class="mt-1 text-sm font-semibold text-petrol/98">nuevas patentes formalizadas estimadas/año</p>
      </div>
      <div class="rounded-2xl border border-petrol/35 bg-petrol/16 p-6 text-center transition-all duration-300 hover:-translate-y-1 hover:border-petrol/40">
        <p id="outIngreso" class="text-3xl font-extrabold text-petrol">$52M</p>
        <p class="mt-1 text-sm font-semibold text-petrol/98">ingreso adicional estimado por recaudación/año</p>
      </div>
    </div>

    <p class="mt-6 text-center text-[11px] text-petrol/98">
      *Estimación referencial para efectos demostrativos, calculada a partir de datos de horas de atención
      presencial reportados por una comuna intermedia. Las cifras finales se ajustan tras el diagnóstico comunal.*
    </p>
  </div>
  </div>
</section>

<script>
  const roiData: Record<string, { horas: string; patentes: string; ingreso: string }> = {
    emergente: { horas: "900", patentes: "120", ingreso: "$18M" },
    intermedia: { horas: "1.800", patentes: "350", ingreso: "$52M" },
    consolidada: { horas: "3.200", patentes: "700", ingreso: "$110M" },
  };

  const comunaSelect = document.getElementById("comunaSelect") as HTMLSelectElement | null;
  const outHoras = document.getElementById("outHoras");
  const outPatentes = document.getElementById("outPatentes");
  const outIngreso = document.getElementById("outIngreso");

  function updateROI() {
    if (!comunaSelect) return;
    const data = roiData[comunaSelect.value];
    if (!data) return;
    if (outHoras) outHoras.textContent = data.horas;
    if (outPatentes) outPatentes.textContent = data.patentes;
    if (outIngreso) outIngreso.textContent = data.ingreso;
  }

  comunaSelect?.addEventListener("change", updateROI);
  updateROI();
</script>
