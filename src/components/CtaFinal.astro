---
import SectionGlow from "./SectionGlow.astro";
import { CONTACT_EMAIL, DIAGNOSTICO_WHATSAPP_LINK } from "../lib/contact";
---

<section id="cta-final" class="relative overflow-hidden bg-petrol/[0.05]">
  <SectionGlow flip />
  <div class="relative mx-auto max-w-4xl px-6 py-24 text-center lg:px-8">
    <h2 class="reveal text-3xl font-extrabold tracking-tight text-petrol sm:text-4xl">
      Transformemos juntos el ecosistema emprendedor de su comuna
    </h2>
    <p class="reveal mx-auto mt-5 max-w-2xl text-petrol/90">
      Coordine una presentación ejecutiva o un plan piloto de 30 días para evaluar la respuesta de sus vecinos, sin
      compromisos iniciales.
    </p>
    <div class="reveal mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        href={DIAGNOSTICO_WHATSAPP_LINK}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-emerald px-8 py-4 text-base font-bold text-petrol shadow-[0_0_36px_rgba(80,200,135,0.3)] transition-all duration-300 hover:-translate-y-1 hover:text-white"
      >
        Escribir por WhatsApp
      </a>
      <a
        href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("Solicitud de diagnóstico comunal")}`}
        class="rounded-full border border-petrol/30 px-8 py-4 text-base font-bold text-petrol transition-all duration-300 hover:-translate-y-1 hover:border-emerald hover:text-emerald"
      >
        Escribir por correo
      </a>
    </div>
  </div>
</section>
