---
interface Props {
  flip?: boolean;
}

const { flip = false } = Astro.props;
---

<div
  class="pointer-events-none absolute inset-0"
  style={`background:
    radial-gradient(55% 45% at 90% 10%, rgb(80 200 135 / 0.55) 0%, rgb(19 147 129 / 0.3) 45%, transparent 75%),
    radial-gradient(60% 50% at 10% 90%, rgb(2 70 85 / 0.45) 0%, rgb(19 147 129 / 0.25) 50%, transparent 80%),
    radial-gradient(50% 50% at 50% 30%, rgb(19 147 129 / 0.35) 0%, rgb(80 200 135 / 0.15) 50%, transparent 75%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);${flip ? " transform: scaleY(-1);" : ""}`}
>
</div>
