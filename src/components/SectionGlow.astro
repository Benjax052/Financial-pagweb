---
interface Props {
  flip?: boolean;
}

const { flip = false } = Astro.props;
---

<div
  class="pointer-events-none absolute inset-0"
  style={`background:
    radial-gradient(78% 65% at 85% 12%, rgb(80 200 135 / 0.15) 0%, rgb(19 147 129 / 0.1) 55%, transparent 88%),
    radial-gradient(82% 70% at 12% 88%, rgb(2 70 85 / 0.13) 0%, rgb(19 147 129 / 0.09) 60%, transparent 88%),
    radial-gradient(72% 65% at 50% 45%, rgb(19 147 129 / 0.1) 0%, rgb(80 200 135 / 0.07) 55%, transparent 85%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);${flip ? " transform: scaleY(-1);" : ""}`}
>
</div>
