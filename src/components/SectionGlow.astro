---
interface Props {
  flip?: boolean;
}

const { flip = false } = Astro.props;
---

<div
  class="pointer-events-none absolute inset-0"
  style={`background:
    radial-gradient(55% 50% at 85% 10%, rgb(80 200 135 / 0.16) 0%, rgb(80 200 135 / 0) 100%),
    radial-gradient(45% 45% at 10% 90%, rgb(2 70 85 / 0.35) 0%, rgb(2 70 85 / 0) 100%),
    radial-gradient(35% 35% at 40% 0%, rgb(19 147 129 / 0.18) 0%, rgb(19 147 129 / 0) 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 22%, black 78%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 22%, black 78%, transparent 100%);${flip ? " transform: scaleY(-1);" : ""}`}
>
</div>
