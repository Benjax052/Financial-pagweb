---
import SectionGlow from "./SectionGlow.astro";

const equipo = [
  { nombre: "Cristobal Pino", rol: "Product Owner", foto: "/team/cristobal.jpg" },
  { nombre: "Nicolás Horta", rol: "Scrum Master", foto: "/team/nicolas.jpg" },
  { nombre: "Vladimir Sagredo", rol: "DevOps", foto: "/team/vladimir.jpg" },
  { nombre: "Jorge Toro", rol: "Backend & Datos", foto: "/team/jorge.jpg" },
  { nombre: "Alejandro Fierro", rol: "QA & Testing", foto: "/team/alejandro.jpg" },
  { nombre: "Benjamín Gómez", rol: "Diseño UX/UI & Marketing", foto: "/team/benjamin.jpg" },
];
---

<section id="equipo" class="relative overflow-hidden py-24">
  <SectionGlow flip />
  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-petrol">Quiénes Estamos Detrás</span>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-petrol sm:text-4xl">
        El equipo detrás de <em class="text-teal italic">Financial</em>
      </h2>
    </div>

    <div class="mx-auto mt-14 grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        equipo.map((persona) => (
          <div class="reveal rounded-2xl border border-petrol/30 bg-petrol/16 p-6 text-center transition-all duration-300 hover:-translate-y-1 hover:border-emerald/30">
            <img
              src={persona.foto}
              alt={`${persona.nombre}, ${persona.rol}`}
              width="96"
              height="96"
              loading="lazy"
              class="mx-auto h-24 w-24 rounded-full border border-petrol/20 object-cover"
            />
            <h3 class="mt-4 text-base font-bold text-petrol">{persona.nombre}</h3>
            <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-petrol">{persona.rol}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
