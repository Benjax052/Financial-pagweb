---
import SectionGlow from "./SectionGlow.astro";

const casos = [
  {
    color: "emerald",
    title: "Ferias Libres y Costumbristas",
    icon: "M3 9.5 12 3l9 6.5M5 10v10h14V10",
  },
  {
    color: "teal",
    title: "Delivery y Cocina Casera",
    icon: "M4 11h16l-1.5 8h-13L4 11ZM8 11V7a4 4 0 0 1 8 0v4",
  },
  {
    color: "white",
    title: "Servicios a Domicilio",
    icon: "M16.707 7.707a1 1 0 0 1 0 1.414l-6 6a1 1 0 0 1-1.414 0l-2-2a1 1 0 1 1 1.414-1.414l1.293 1.293 5.293-5.293a1 1 0 0 1 1.414 0ZM4 12a8 8 0 1 0 16 0 8 8 0 0 0-16 0Z",
  },
  {
    color: "emerald",
    title: "Comercio de Barrio",
    icon: "M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6",
  },
];

const colorClasses: Record<string, string> = {
  emerald: "bg-emerald/80 text-petrol",
  teal: "bg-teal/60 text-petrol",
  white: "bg-petrol/40 text-petrol",
};

const hoverBorderClasses: Record<string, string> = {
  emerald: "hover:border-emerald/30",
  teal: "hover:border-teal/30",
  white: "hover:border-petrol/40",
};
---

<section id="casos-de-uso" class="relative overflow-hidden py-24">
  <SectionGlow flip />
  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-petrol"
        >Emprendimientos Reales, Resultados Reales</span
      >
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-petrol sm:text-4xl">
        Diseñado para la economía real de su comuna
      </h2>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        casos.map((caso) => (
          <div class={`reveal rounded-2xl border border-petrol/30 bg-petrol/16 p-6 text-center transition-all duration-300 hover:-translate-y-1 ${hoverBorderClasses[caso.color]}`}>
            <div class={`mx-auto grid h-11 w-11 place-items-center rounded-xl ${colorClasses[caso.color]}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d={caso.icon} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <h3 class="mt-4 text-base font-bold text-petrol">{caso.title}</h3>
          </div>
        ))
      }
    </div>
  </div>
</section>
