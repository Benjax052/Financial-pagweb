---
const items = [
  {
    title: "Canal oficial Meta",
    desc: "Encriptación vía WhatsApp Business API verificada, sin apps de terceros.",
  },
  {
    title: "Trazabilidad completa",
    desc: "Logs auditables de cada expediente para control interno municipal.",
  },
  {
    title: "Acceso por roles",
    desc: "Permisos diferenciados para DAF, SECPLA y Dirección de Rentas.",
  },
];
---

<section id="seguridad" class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
  <div class="grid grid-cols-1 gap-14 lg:grid-cols-2">
    <div class="reveal">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald">Confianza & Cumplimiento</span>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Datos protegidos con estándares de nivel gubernamental.
      </h2>
      <p class="mt-5 text-white/60">
        Cada conversación y expediente se maneja bajo protocolos diseñados para instituciones públicas, no para un
        chatbot genérico.
      </p>
    </div>

    <div class="reveal flex flex-col">
      {
        items.map((item, i) => (
          <div class={`py-6 ${i === 0 ? "" : "border-t border-white/10"}`}>
            <h3 class="font-bold text-white">{item.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-white/60">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
