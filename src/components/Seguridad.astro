---
import SectionGlow from "./SectionGlow.astro";

const items = [
  {
    color: "emerald",
    icon: "M12 3 5 6v5c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Z M9 12l2 2 4-4",
    title: "Canal oficial Meta",
    desc: "Encriptación vía WhatsApp Business API verificada, sin apps de terceros.",
  },
  {
    color: "teal",
    icon: "M7 3h8l4 4v14H7V3Z M15 3v4h4 M9 12h6 M9 16h6",
    title: "Trazabilidad completa",
    desc: "Logs auditables de cada expediente para control interno municipal.",
  },
  {
    color: "white",
    icon: "M6 10V8a6 6 0 1 1 12 0v2 M5 10h14v10H5V10Z M12 14v3",
    title: "Acceso por roles",
    desc: "Permisos diferenciados para la Dirección de Administración y Finanzas (DAF), la Secretaría Comunal de Planificación (SECPLA) y la Dirección de Rentas.",
  },
];

const colorClasses: Record<string, string> = {
  emerald: "bg-emerald/10 text-emerald",
  teal: "bg-teal/10 text-teal",
  white: "bg-petrol/20 text-petrol",
};
---

<section id="seguridad" class="relative overflow-hidden py-24">
  <SectionGlow />
  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
  <div class="grid grid-cols-1 gap-14 lg:grid-cols-2">
    <div class="reveal">
      <span class="text-sm font-bold uppercase tracking-widest text-petrol">Confianza & Cumplimiento</span>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-petrol sm:text-4xl">
        Datos protegidos con estándares de nivel gubernamental
      </h2>
      <p class="mt-5 text-petrol/90">
        Cada conversación y expediente se maneja bajo protocolos diseñados para instituciones públicas, no para un
        chatbot genérico.
      </p>
    </div>

    <div class="reveal flex flex-col">
      {
        items.map((item, i) => (
          <div class={`flex gap-4 py-6 ${i === 0 ? "" : "border-t border-petrol/20"}`}>
            <div class={`grid h-11 w-11 shrink-0 place-items-center rounded-xl ${colorClasses[item.color]}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d={item.icon} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-petrol">{item.title}</h3>
              <p class="mt-1.5 text-base leading-relaxed text-petrol/90">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  </div>
</section>
