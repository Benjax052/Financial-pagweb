---
import isotipo from "../assets/Financial isotipo.svg";
import feswLogo from "../assets/Logo Light Mode FESW.svg";
---

<footer class="border-t border-white/10 bg-black py-16">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-3 px-6 text-center lg:px-8">
    <span class="text-[11px] font-semibold uppercase tracking-wide text-white/40">Un proyecto presentado en</span>
    <a
      href="https://informatica.usm.cl/eventos/33-feria-de-software/"
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-xl bg-white px-4 py-2.5 transition-opacity hover:opacity-90"
    >
      <img src={feswLogo.src} alt="Feria de Software" class="h-9 w-auto" />
    </a>
  </div>

  <div class="mx-auto mt-14 grid max-w-7xl grid-cols-1 gap-10 border-t border-white/10 px-6 pt-14 sm:grid-cols-3 lg:px-8">
    <div>
      <div class="flex items-center gap-2.5">
        <img src={isotipo.src} alt="" class="h-8 w-8" />
        <span class="font-extrabold text-white">Financial</span>
      </div>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-white/50">
        Plataforma de formalización municipal con agentes de IA sobre WhatsApp.
      </p>
    </div>

    <div>
      <h3 class="text-sm font-bold text-white">Explora</h3>
      <nav class="mt-4 flex flex-col gap-2.5 text-sm text-white/50">
        <a href="#como-funciona" class="transition-colors hover:text-emerald">¿Cómo funciona?</a>
        <a href="#municipalidad" class="transition-colors hover:text-emerald">Para la Municipalidad</a>
        <a href="#impacto-roi" class="transition-colors hover:text-emerald">Impacto & ROI</a>
        <a href="#casos-de-uso" class="transition-colors hover:text-emerald">Casos de Uso</a>
        <a href="#seguridad" class="transition-colors hover:text-emerald">Seguridad</a>
      </nav>
    </div>

    <div>
      <h3 class="text-sm font-bold text-white">Contáctanos</h3>
      <div class="mt-4 flex flex-col gap-2.5 text-sm text-white/50">
        <a href="mailto:grupofinancial06@gmail.com" class="transition-colors hover:text-emerald"
          >grupofinancial06@gmail.com</a
        >
        <a href="https://wa.me/56954419466" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-emerald"
          >+56 9 5441 9466</a
        >
      </div>

      <div class="mt-5 flex items-center gap-3">
        <a
          href="https://www.instagram.com/financial.cl?igsi=MTBidzY3NGNqMnJuMw=="
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="grid h-9 w-9 place-items-center rounded-full border border-white/10 text-white/50 transition-colors hover:border-emerald/40 hover:text-emerald"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8" />
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
          </svg>
        </a>
        <span
          aria-label="LinkedIn (próximamente)"
          title="Próximamente"
          class="grid h-9 w-9 cursor-not-allowed place-items-center rounded-full border border-white/10 text-white/20"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.8" />
            <path
              d="M7 10.5V17M7 7v.01M11 17v-4.5a2 2 0 0 1 4 0V17M11 17v-6.5"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </div>
    </div>
  </div>

  <div
    class="mx-auto mt-14 flex max-w-7xl flex-col items-center justify-between gap-4 border-t border-white/10 px-6 pt-8 text-xs text-white/40 sm:flex-row lg:px-8"
  >
    <p>© 2026 Financial · Plataforma de Formalización Municipal.</p>
    <p>Hecho para transformar la economía informal de su comuna.</p>
  </div>
</footer>
